# HomeServis Yapılandırma Dosyası Örneği
# Bu dosyayı '.env' olarak kopyalayıp değerleri güncelleyebilirsiniz: cp .env.example .env

# Flask Güvenlik Anahtarı
SECRET_KEY=gizli_anahtar_degistirin_123

# Sunucu Ağ Ayarları
HOST=0.0.0.0
PORT=5000

# Opsiyonel Donanım Ayarları:
# Belirli bir seri portu sabitlemek isterseniz (boş bırakılırsa otomatik bulunur)
# ARDUINO_PORT=/dev/ttyUSB0

# Belirli bir kamera indexi (boş bırakılırsa 0, 1, 2 taranır)
# CAMERA_INDEX=0
